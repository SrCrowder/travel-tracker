# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# URL of the frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# Optional login. Leave WEB_PASSWORD empty to keep the app open (LAN use).
# WEB_USER=admin
# WEB_PASSWORD=change-me
# Sessions last SESSION_DAYS days (default 30)
# SESSION_DAYS=30

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Used by Vite — must be prefixed with VITE_
VITE_API_URL=http://localhost:3001
